FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

scale   0.01;
L       1;

vertices
(
    (0		0	0)
    ($L		0	0)
    ($L 	$L	0)
    (0		$L	0)
    (0		0	$L)
    ($L		0	$L)
    ($L		$L	$L)
    (0		$L	$L)
);

blocks          
(
    hex (0 1 2 3 4 5 6 7) (150 150 150) simpleGrading (1 1 1)
);

edges           
(
);

boundary
(

    upperBoundary 
    {
        type cyclic;
        neighbourPatch lowerBoundary;
        faces
        (
            (3 7 6 2)
        );
    }
    lowerBoundary
    {
        type cyclic;
        neighbourPatch upperBoundary;
        faces
        (
            (1 5 4 0)
        );
     }    
     leftBoundary
     {
        type cyclic;
        neighbourPatch rightBoundary;
        faces
        (
            (0 4 7 3)
        );
      }
      rightBoundary
      {
         type cyclic;
         neighbourPatch leftBoundary;
         faces
         (
             (2 6 5 1)
         );
       }
     backBoundary
     {
        type cyclic;
        neighbourPatch frontBoundary;
        faces
        (
            (0 3 2 1)
        );
      }
      frontBoundary
      {
         type cyclic;
         neighbourPatch backBoundary;
         faces
         (
             (4 5 6 7)
         );
       }
