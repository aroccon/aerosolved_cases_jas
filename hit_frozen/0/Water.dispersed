FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Water.dispersed;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1.281859E-06;

boundaryField                 
{                                          
	 upperBoundary                           
	 {                                       
		 type       	 cyclic;                 
	 }                                       

	 lowerBoundary                           
	 {                                       
		 type       	 cyclic;                 
	 }                                       

	 leftBoundary                            
	 {                                       
		 type       	 cyclic;                 
	 }                                       

	 rightBoundary                           
	 {                                       
		 type       	 cyclic;                 
	 }                                       

	 frontBoundary                            
	 {                                       
		 type       	 cyclic;                  
	 }            

         backBoundary
         {
                 type            cyclic;
         }
                           
}
