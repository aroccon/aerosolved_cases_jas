FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      kinematicCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          		true;
    coupled         		no;
    transient       		yes;
    cellValueSourceCorrection	no;
    maxCo           		0.01;

    interpolationSchemes
    	{
        	rho             	cell;
        	U               	cellPoint;
        	muc             	cell;
        	thermo:mu		cell;
        	p			cell;
        	electricPotential:E	cellPoint;
    	}

	integrationSchemes
	{
		U	Euler;
	}
}

constantProperties
{
	rho0	1000;
}

subModels
{
	injectionModels
	{
		injector
		{
			type		manualInjection;
			parcelBasisType	fixed;
			nParticle	1;
			massTotal	1.0;
			U0		(0.0 0.0 0.0);
			SOI		0.0;
			positionsFile	"kinematicCloudPosition";
			sizeDistribution
			{
                		type         fixedValue;
               			fixedValueDistribution
                		{
                    			value        1e-5;
                		}
			}
		}
	}

    particleForces
    {
        sphereDrag;
        gravity;
    };

    dispersionModel none;

    patchInteractionModel standardWallInteraction;

    stochasticCollisionModel none;

    surfaceFilmModel none;

    standardWallInteractionCoeffs
    {
        type            escape;
    }
}


