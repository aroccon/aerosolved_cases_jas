FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      ArtificialFluid.continuous;
}

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 9.961908E-1;

boundaryField
{
    movingWall
    {
        type            zeroGradient;
    }

    fixedWalls
    {
        type            zeroGradient;
    }

    frontAndBack
    {
        type            empty;
    }
}
