FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      aerosolProperties;
}

aerosolModel    fixedSectional;

diameter
{
    min     1E-6;
    max     1E-5;
}

fixedSectionalCoeffs
{
    distribution
    {
        type    list;
        // 3 sections = M1, M5, M9 of the 9-section runs (same representative masses x:
        // d = 1.5, 5.5, 9.5 um). Boundaries 1, 2, 6, 10 um: irrelevant without growth/coalescence.
        y       (5.235988E-16 4.188790E-15 1.130973E-13 5.235988E-13);
        x       (1.767146E-15 8.711375E-14 4.489205E-13);
    }

    interpolation
    {
        type    twoMoment;
    }

    rescale     false;

    initFromPatch	upperBoundary;
}

submodels
{
    condensation
    {
        type        none;
    }

    nucleation
    {
        type        none;
    }

    coalescence
    {
        type        none;
    }

    driftFluxModel
    {
        continuousDiffusion
        {
            type        none;
        }

        dispersedDiffusion
        {
            type        none;
        }

        dispersedInertialDrift
        {
            type            fullStokes;

            maxIter         10;
            tolerance       1E-6;

            VMax            10.0;
        }
    }
}