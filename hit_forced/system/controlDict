FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}

application     aerosolEulerFoam;

startFrom       latestTime;

startTime       0.0;

stopAt          endTime;

endTime         0.02;

deltaT          5E-6;

adjustTimeStep  yes;

maxCo           0.25;

maxDeltaT       1E-5;

writeControl    adjustableRunTime;

writeInterval   2e-3;

purgeWrite      0;

writeFormat     binary;

writePrecision  8;

writeCompression false;

timeFormat      general;

timePrecision   10;

runTimeModifiable yes;
functions
{
    magSqrU
    {
        type            magSqr;
        libs            (fieldFunctionObjects);
        field           U;
        result          magSqr(U);
        executeControl  timeStep;
        executeInterval 50;
        writeControl    none;
    }

    kineticEnergy
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        fields          (magSqr(U));
        operation       volAverage;
        regionType      all;
        writeFields     false;
        executeControl  timeStep;
        executeInterval 50;
        writeControl    timeStep;
        writeInterval   50;
    }
}

