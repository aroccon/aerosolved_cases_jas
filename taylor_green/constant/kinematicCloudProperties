FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      kinematicCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Lagrangian cloud evolved by aerosolEulerFoam (one-way coupling) on the same
// mesh and carrier flow as the Eulerian aerosol. Solution settings as in the
// cavity cases (cavity_1000, cavity_3200); injectors from taylor_vortex_DPM_coupled:
// 9000 particles, d uniform in [1,10] um, U0 = fluid velocity at t = 0.

solution
{
    active          		true;
    coupled         		no;
    transient       		yes;
    cellValueSourceCorrection	no;
    maxCo           		0.01;
    interpolationSchemes
    	{
        	rho             	cell;
        	U               	cellPoint;
        	muc             	cell;
        	thermo:mu		cell;
        	p			cell;
        	electricPotential:E	cellPoint;
    	}
	integrationSchemes
	{
		U	Euler;
	}
}

constantProperties
{
	rho0	1000;
}

subModels
{
	injectionModels
	{
		#include "constInjectorData"
	}

	particleForces
	{
		sphereDrag;
	}

	dispersionModel			none;

	patchInteractionModel		standardWallInteraction;

	stochasticCollisionModel	none;

	surfaceFilmModel		none;

	standardWallInteractionCoeffs
	{
		type            escape;
	}
}


